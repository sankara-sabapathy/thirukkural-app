{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "config": "node scripts/set-env.js",
    "build": "ng build",
    "build:ssg": "ng build && npm run prerender && npm run generate-sitemap",
    "build:ssg:development": "ng build --configuration development && npm run prerender && npm run generate-sitemap",
    "build:ssg:production": "ng build --configuration production && npm run prerender && npm run generate-sitemap",
    "sync:kural-data": "node ../scripts/split-data.js",
    "serve:ssg": "node scripts/serve-ssg.js",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "prerender": "tsx scripts/prerender.ts",
    "generate-sitemap": "tsx scripts/sitemap.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "21.0.0",
    "@angular/cdk": "21.0.0",
    "@angular/common": "21.0.0",
    "@angular/compiler": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/forms": "21.0.0",
    "@angular/material": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/platform-browser-dynamic": "21.0.0",
    "@angular/router": "21.0.0",
    "@angular/service-worker": "21.0.0",
    "@aws-amplify/ui-angular": "^5.1.6",
    "aws-amplify": "^6.15.8",
    "html2canvas": "^1.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.1",
    "@angular/build": "21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsdom": "^27.1.0",
    "puppeteer": "^24.39.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.1"
  }
}

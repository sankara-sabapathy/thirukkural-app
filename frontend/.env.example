# Frontend Environment Variables
# Copy this file to .env and fill in your values
# These are used by scripts/set-env.js during build

# API Configuration
API_BASE_URL=https://api.example.com

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-south-1_xxxxx
COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxx
COGNITO_DOMAIN=your-app.auth.ap-south-1.amazoncognito.com
COGNITO_REDIRECT_SIGNIN=https://your-app.example.com/callback
COGNITO_REDIRECT_SIGNOUT=https://your-app.example.com/

# VAPID Keys (Required for Push Notifications)
# Generate using: npx web-push generate-vapid-keys
# Only the PUBLIC key is needed for frontend
VAPID_PUBLIC_KEY=your-vapid-public-key
